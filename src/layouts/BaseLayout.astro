---
// Document shell shared by every page: <head> (fonts, SEO, icons, structured data), header, main, footer.
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SeoHead from '../components/seo/SeoHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { LOCALE_META, type Locale } from '../i18n/locales';
import type { RouteKey } from '../i18n/routes';
import { SITE } from '../site.config';
import { organization, website } from '../lib/structured-data';
import '../styles/global.css';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
  /** <title>, also used for social cards. */
  title: string;
  description: string;
  socialImage?: { src: ImageMetadata; alt: string };
  /** Page-specific JSON-LD nodes, added to the organisation and website nodes. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
}

const { locale, routeKey, title, description, socialImage, structuredData = [], noindex } = Astro.props;
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" />
    <SeoHead locale={locale} routeKey={routeKey} title={title} description={description} image={socialImage} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <StructuredData nodes={[organization(locale), website(), ...structuredData]} />
  </head>
  <body>
    <SiteHeader locale={locale} routeKey={routeKey} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} routeKey={routeKey} />
  </body>
</html>
