---
// Image with optional caption, served at 1×, 1.5× and 2× pixel densities.
// `width` is the largest width the image is displayed at, in CSS pixels.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  caption?: string;
  /** Screenshots get a frame so they stand out from the page. */
  frame?: boolean;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, width = 720, caption, frame = false, class: className, loading = 'lazy' } = Astro.props;
const displayWidth = Math.min(width, src.width);
// Screenshots saved as PNG compress better (and stay sharper) as PNG than as WebP.
const format = frame && src.format === 'png' ? 'png' : undefined;
---

<figure class:list={['content-image', { 'content-image--framed': frame }, className]}>
  <Image src={src} alt={alt} width={displayWidth} densities={[1.5, 2]} loading={loading} format={format} />
  {caption && <figcaption class="content-image__caption">{caption}</figcaption>}
</figure>

<style>
  .content-image {
    margin-block: var(--space-l);
  }

  .content-image :global(img) {
    border-radius: var(--radius-m);
  }

  .content-image--framed :global(img) {
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    background: var(--ziggles-white);
  }

  .content-image__caption {
    margin-top: var(--space-xs);
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
</style>
