---
// Responsive grid of <FeatureCard> items.
---

<ul class="feature-grid" role="list">
  <slot />
</ul>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-m);
    margin-block: var(--space-l);
    padding: 0;
    list-style: none;
  }

  /* Exactly five cards: one row on wide screens rather than four and a lonely fifth. */
  @media (min-width: 64rem) {
    .feature-grid:has(> :nth-child(5):last-child) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
