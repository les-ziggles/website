---
// Links to the same page in every language (or to the home page for pages outside the route map).
import { LOCALES, LOCALE_META, type Locale } from '../../i18n/locales';
import { pathFor, type RouteKey } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
}

const { locale, routeKey = 'home' } = Astro.props;
const t = useTranslations(locale);
---

<nav class="language-switcher" aria-label={t('a11y.languageSwitcher')}>
  <ul class="language-switcher__list">
    {
      LOCALES.map((l) => (
        <li>
          <a
            class="language-switcher__link"
            href={pathFor(routeKey, l)}
            hreflang={LOCALE_META[l].hreflang}
            lang={LOCALE_META[l].hreflang}
            aria-current={l === locale ? 'page' : undefined}
          >
            {l.toUpperCase()}
            <span class="visually-hidden"> – {LOCALE_META[l].label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .language-switcher__list {
    display: flex;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .language-switcher__link {
    display: inline-block;
    min-width: 2.75rem;
    padding: var(--space-xs) var(--space-xs);
    border-radius: var(--radius-s);
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--font-size-small);
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .language-switcher__link:hover {
    color: var(--color-text);
  }

  .language-switcher__link[aria-current='page'] {
    color: var(--ziggles-navy);
    background: var(--ziggles-gold);
  }
</style>
