---
// A cluster of palm trees swaying in the sea breeze, on the right of the footer top edge, each casting
// its shadow on the ground. Decorative.
import palmSvg from '../../assets/brand/ziggles-palm-tree.svg?raw';

// Path data of the palm artwork; its own coordinate box is 649 678 123 154.
const palmPath = palmSvg.match(/\sd="([^"]+)"/)![1];

// Each cluster is a 360×160 scene, pinned to its side of the screen; the ground is its bottom edge.
// x: left edge of the tree, scale: size, strength: how much it moves, flip: mirrored.
const CLUSTERS = {
  right: [
    { x: 100, scale: 0.75, strength: 0.9, flip: false },
    { x: 210, scale: 1, strength: 1.1, flip: false },
  ],
};
const SCENE = { width: 360, height: 160 };

// Shadows: every point of a tree is projected onto the ground, with the sun low on the right, in front of the trees.
// A point `h` above the ground lands LENGTH × h to the left and DEPTH × h up (ground seen at a low angle).
// The projection is a plain transform of a <use> copy, so the shadow follows the wind animation for free.
const SHADOW = { length: 0.85, depth: 0.24 };
const shadowTransform = `matrix(1 0 ${SHADOW.length} ${SHADOW.depth} ${-SCENE.height * SHADOW.length} ${SCENE.height * (1 - SHADOW.depth)})`;

const transformFor = ({ x, scale, flip }: { x: number; scale: number; flip: boolean }) =>
  `translate(${x + (flip ? 123 * scale : 0)} ${SCENE.height - 154 * scale}) scale(${flip ? -scale : scale} ${scale}) translate(-649 -678)`;
---

<div class="palm-grove" data-palm-grove aria-hidden="true">
  {
    Object.entries(CLUSTERS).map(([side, palms]) => (
      <svg class:list={['palm-grove__cluster', `palm-grove__cluster--${side}`]} viewBox={`0 0 ${SCENE.width} ${SCENE.height}`} focusable="false">
        <g class="palm-grove__shadows">
          {palms.map((_, index) => (
            <use href={`#palm-grove-${side}-${index}`} transform={shadowTransform} />
          ))}
        </g>
        {palms.map((palm, index) => (
          // A mirrored tree must bend the other way in its own coordinates to follow the same wind.
          <path
            id={`palm-grove-${side}-${index}`}
            class="palm-grove__palm"
            data-palm
            data-palm-strength={palm.strength}
            data-palm-wind={palm.flip ? -1 : 1}
            d={palmPath}
            transform={transformFor(palm)}
          />
        ))}
      </svg>
    ))
  }
</div>

<script>
  import { animatePalms } from '../../scripts/palm-wind';
  document.querySelectorAll('[data-palm-grove]').forEach(animatePalms);
</script>

<style>
  .palm-grove {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    pointer-events: none;
    overflow: hidden;
  }

  .palm-grove__cluster {
    height: clamp(5.5rem, 4rem + 6vw, 10rem);
    width: auto;
    aspect-ratio: 360 / 160;
    margin-bottom: -1px;
  }

  /* Same navy as the footer: the trees rise out of it as silhouettes. */
  .palm-grove__palm {
    fill: var(--ziggles-navy);
  }

  /* One group opacity, so overlapping shadows do not get darker where they cross. */
  .palm-grove__shadows {
    opacity: 0.2;
  }
</style>
