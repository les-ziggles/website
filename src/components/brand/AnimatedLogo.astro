---
// The full club badge with its sea waves and frisbee throw animation (landing page hero).
import LogoArt from '../../assets/brand/ziggles-logo-animated.svg';
import type { Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<div class:list={['animated-logo', className]} role="img" aria-label={t('a11y.logoAnimated')} data-animated-logo>
  <LogoArt class="animated-logo__art" aria-hidden="true" focusable="false" />
</div>

<script>
  import { animateLogo } from '../../scripts/logo-animation';
  document.querySelectorAll<SVGSVGElement>('[data-animated-logo] svg').forEach(animateLogo);
</script>

<style>
  .animated-logo {
    aspect-ratio: 896 / 1200;
  }

  .animated-logo__art {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 18px 40px rgb(0 0 0 / 0.35));
  }
</style>
