---
// Button pausing or resuming every animation of the site (WCAG 2.2.2 "Pause, Stop, Hide").
// Hidden until scripts run, since without JavaScript nothing moves.
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  class:list={['animation-toggle', className]}
  data-animation-toggle
  data-label-pause={t('motion.pause')}
  data-label-play={t('motion.play')}
  hidden
>
  <Icon name="pause" size={16} class="animation-toggle__pause" />
  <Icon name="play" size={16} class="animation-toggle__play" />
  <span class="animation-toggle__label">{t('motion.pause')}</span>
</button>

<script>
  import { animationsEnabled, onAnimationsChange, setAnimationsEnabled } from '../../scripts/motion';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-animation-toggle]');
  const render = (enabled: boolean) => {
    for (const button of buttons) {
      button.hidden = false;
      button.dataset.state = enabled ? 'playing' : 'paused';
      button.querySelector('.animation-toggle__label')!.textContent = (enabled ? button.dataset.labelPause : button.dataset.labelPlay) ?? '';
    }
  };
  buttons.forEach((button) => button.addEventListener('click', () => setAnimationsEnabled(!animationsEnabled())));
  onAnimationsChange(render);
  render(animationsEnabled());
</script>

<style>
  .animation-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    cursor: pointer;
  }

  .animation-toggle[hidden] {
    display: none;
  }

  .animation-toggle:hover {
    color: var(--color-text);
  }

  .animation-toggle[data-state='playing'] :global(.animation-toggle__play),
  .animation-toggle[data-state='paused'] :global(.animation-toggle__pause),
  .animation-toggle:not([data-state]) :global(.animation-toggle__play) {
    display: none;
  }
</style>
