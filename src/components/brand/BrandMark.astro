---
// Compact brand lockup: eagle head + ZIGGLES wordmark + tagline. Used in the header and footer.
import { Image } from 'astro:assets';
import eagleHead from '../../assets/brand/ziggles-eagle-head.svg';
import type { Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  size?: 'compact' | 'large';
  /** Eager in the header (visible on load), lazy elsewhere. */
  loading?: 'eager' | 'lazy';
}

const { locale, size = 'compact', loading = 'lazy' } = Astro.props;
const t = useTranslations(locale);
---

<span class:list={['brand-mark', `brand-mark--${size}`]}>
  <Image class="brand-mark__eagle" src={eagleHead} alt="" width={size === 'large' ? 72 : 48} loading={loading} />
  <span class="brand-mark__text">
    <span class="brand-mark__name">Ziggles</span>
    <span class="brand-mark__tagline">{t('site.tagline')}</span>
  </span>
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    color: var(--color-text);
  }

  .brand-mark__eagle {
    width: 3rem;
    height: auto;
  }

  .brand-mark__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-mark__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .brand-mark__tagline {
    margin-top: 0.3em;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--color-highlight-on-dark);
  }

  .brand-mark--large .brand-mark__eagle {
    width: 4.5rem;
  }

  .brand-mark--large .brand-mark__name {
    font-size: 2.25rem;
  }

  .brand-mark--large .brand-mark__tagline {
    font-size: 0.85rem;
  }
</style>
