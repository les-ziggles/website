---
// Small line icons (24×24, drawn with currentColor). Decorative by default: pass `label` when the
// icon is the only content of a control.
interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const ICONS = {
  'arrow-right': { stroke: ['M5 12h14', 'M13 6l6 6-6 6'] },
  calendar: { stroke: ['M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z', 'M16 3v4', 'M8 3v4', 'M3 10h18'] },
  clock: { stroke: ['M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18z', 'M12 7v5l3 2'] },
  'map-pin': { stroke: ['M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z', 'M12 7.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z'] },
  mail: { stroke: ['M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z', 'M3 7l9 6 9-6'] },
  users: { stroke: ['M9 4.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7z', 'M2.5 20a6.5 6.5 0 0 1 13 0', 'M16 4.5a3.5 3.5 0 0 1 0 7', 'M18 14a6 6 0 0 1 3.5 6'] },
  disc: { stroke: ['M12 7c5 0 9 2.2 9 5s-4 5-9 5-9-2.2-9-5 4-5 9-5z', 'M12 9.4c2.8 0 5 1.2 5 2.6s-2.2 2.6-5 2.6-5-1.2-5-2.6 2.2-2.6 5-2.6z'] },
  trophy: { stroke: ['M8 4h8v5a4 4 0 0 1-8 0z', 'M8 6H5a3 3 0 0 0 3 4', 'M16 6h3a3 3 0 0 1-3 4', 'M12 13v4', 'M8 20h8', 'M10 17h4v3h-4z'] },
  external: { stroke: ['M14 4h6v6', 'M20 4l-9 9', 'M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5'] },
  menu: { stroke: ['M4 7h16', 'M4 12h16', 'M4 17h16'] },
  close: { stroke: ['M6 6l12 12', 'M18 6L6 18'] },
  play: { fill: ['M8 5v14l11-7z'] },
  pause: { fill: ['M7 5h3.5v14H7z', 'M13.5 5H17v14h-3.5z'] },
  facebook: { fill: ['M14 8.5V7c0-.6.4-1 1-1h2V2.5h-3A4.5 4.5 0 0 0 9.5 7v1.5H7V12h2.5v9.5H14V12h2.6l.4-3.5z'] },
  instagram: { stroke: ['M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3z', 'M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8z', 'M17.3 6.7v.01'] },
} satisfies Record<string, { stroke?: string[]; fill?: string[] }>;

export type IconName = keyof typeof ICONS;

const { name, size = 20, label, class: className } = Astro.props;
const icon: { stroke?: string[]; fill?: string[] } = ICONS[name];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  {icon.stroke?.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />)}
  {icon.fill?.map((d) => <path d={d} fill="currentColor" />)}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
